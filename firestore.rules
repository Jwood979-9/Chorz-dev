rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication Check
    function isAuthenticated() { 
      return request.auth != null; 
    }

    // Role-Based Access Control (Checks Token First, Database Fallback)
    function isManager() {
      return isAuthenticated() && (
        ( ('role' in request.auth.token) && (request.auth.token.role in ["manager", "clinic_admin", "owner"]) )
        ||
        ( exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["manager", "clinic_admin", "owner"] )
      );
    }

    // 🌟 THE FIX: Multi-Tenant Isolation Check (Checks Token First, Database Fallback)
    function isCorrectClinic(targetClinicId) {
       return isAuthenticated() && (
         // Option 1: It's in the custom token (Tech PIN login)
         ( ('clinicId' in request.auth.token) && (request.auth.token.clinicId == targetClinicId) )
         ||
         // Option 2: Database fallback (Manager Email/Password login)
         ( exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == targetClinicId )
       );
    }

    // ==========================================
    // CLINIC SETTINGS & AUDIT LOGS
    // ==========================================
    match /clinics/{clinicId} {
      // Users can only read their own clinic's document
      allow read: if isCorrectClinic(clinicId);
      allow write: if isManager() && isCorrectClinic(clinicId); 

      // Subcollection Access: Enforced multi-tenant isolation
      match /audit_logs/{logId} {
        allow read: if isManager() && isCorrectClinic(clinicId);
        allow write: if false; // Block client writes; force everything through the Cloud Functions
      }
    }

    // ==========================================
    // TASKS
    // ==========================================
    match /tasks/{taskId} {
      // Users can only read/update tasks belonging to their clinic
      allow read, update: if isCorrectClinic(resource.data.clinicId);
      
      // Managers must be in the correct clinic to create/delete tasks
      allow create: if isManager() && isCorrectClinic(request.resource.data.clinicId);
      allow delete: if isManager() && isCorrectClinic(resource.data.clinicId);
    }

    // ==========================================
    // USERS (STAFF)
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile, or Managers can read profiles in their clinic
      allow read: if isAuthenticated() && (request.auth.uid == userId || (isManager() && isCorrectClinic(resource.data.clinicId)));
      
      // Managers can only create/update staff assigned to their clinic
      allow create: if isManager() && isCorrectClinic(request.resource.data.clinicId);
      allow update, delete: if isManager() && isCorrectClinic(resource.data.clinicId);
    }

    // ==========================================
    // ALERTS
    // ==========================================
    match /alerts/{alertId} {
      allow read: if isCorrectClinic(resource.data.clinicId); 
      allow create: if isManager() && isCorrectClinic(request.resource.data.clinicId);
      allow update, delete: if isManager() && isCorrectClinic(resource.data.clinicId);
    }

    // ==========================================
    // LOCKOUTS (Backend Only)
    // ==========================================
    match /kiosk_lockouts/{kioskId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    match /device_lockouts/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
  }
}